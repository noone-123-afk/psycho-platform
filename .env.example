NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/psycho_platform
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Keep sandbox for testing. Set PAYPAL_ENV=live and use matching live credentials
# in the hosting provider's secret settings only after production approval.
# The webhook ID must belong to the same PayPal environment as the credentials.
# PAYPAL_API_BASE is not used; the SDK selects the API endpoint from PAYPAL_ENV.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# Optional: when set, SendGrid is used instead of SMTP. Store real keys as secrets.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@example.com
FROM_NAME=Soul Compass
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
